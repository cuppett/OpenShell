# Development container for OpenShell contributors. Works with rootless Podman
# and Docker. See .devcontainer/README.md for usage and design notes.
#
# The system dependency set mirrors deploy/docker/Dockerfile.ci so local
# builds and CI agree. Keep the two in sync.

FROM docker.io/library/ubuntu:noble

ENV DEBIAN_FRONTEND=noninteractive

# System build dependencies (mirrors Dockerfile.ci):
# - build-essential, cmake: aws-lc-sys (openshell-crypto's default backend)
# - libz3-dev, pkg-config: z3-sys via openshell-prover -> openshell-server
# - clang, libclang-dev: bindgen users and parity with CI
# - libssl-dev: openshell-crypto's optional `openssl` feature
# - musl-tools: static musl targets
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang \
    cmake \
    curl \
    git \
    jq \
    libclang-dev \
    libssl-dev \
    libz3-dev \
    musl-tools \
    openssh-client \
    perl \
    pkg-config \
    sudo \
    unzip \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# mise (NOTE: keep this version in sync with min_version in mise.toml and
# MISE_VERSION in deploy/docker/Dockerfile.ci).
ARG MISE_VERSION=v2026.9.9
RUN curl -fsSL https://mise.run \
    | MISE_VERSION="${MISE_VERSION}" MISE_INSTALL_PATH=/usr/local/bin/mise sh

# Rust toolchain via rustup. CARGO_HOME and RUSTUP_HOME live outside the user's
# home so the Cargo registry and git caches can be mounted as named volumes.
# The `rustlang` group owns both trees so the dev user can write to them even
# after updateRemoteUserUID changes its UID.
#
# NOTE: keep RUST_VERSION in sync with rust-toolchain.toml and mise.toml.
# Rustup still honors rust-toolchain.toml at build time, so drift costs a
# toolchain download, not a wrong compiler.
ARG RUST_VERSION=1.95.0
ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup
ENV PATH="${CARGO_HOME}/bin:${PATH}"
RUN groupadd --system rustlang \
    && mkdir -p "${CARGO_HOME}" "${RUSTUP_HOME}" \
    && curl -fsSL https://sh.rustup.rs \
    | sh -s -- -y --no-modify-path --profile minimal --default-toolchain none \
    && rustup toolchain install "${RUST_VERSION}" --profile minimal \
        --component rustfmt --component rust-src --component rust-analyzer \
    && rustup default "${RUST_VERSION}" \
    && mkdir -p "${CARGO_HOME}/registry" "${CARGO_HOME}/git" \
    && chown -R root:rustlang "${CARGO_HOME}" "${RUSTUP_HOME}" \
    && chmod -R g+w "${CARGO_HOME}" "${RUSTUP_HOME}" \
    && find "${CARGO_HOME}" "${RUSTUP_HOME}" -type d -exec chmod g+s {} +

# Non-root dev user. Ubuntu images ship an `ubuntu` user at UID 1000; remove it
# so `vscode` gets the conventional UID that updateRemoteUserUID remaps.
ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=1000
RUN if id ubuntu >/dev/null 2>&1; then userdel --remove ubuntu; fi \
    && groupadd --gid "${USER_GID}" "${USERNAME}" \
    && useradd --uid "${USER_UID}" --gid "${USER_GID}" --groups rustlang \
        --create-home --shell /bin/bash "${USERNAME}" \
    && echo "${USERNAME} ALL=(root) NOPASSWD:ALL" > "/etc/sudoers.d/${USERNAME}" \
    && chmod 0440 "/etc/sudoers.d/${USERNAME}" \
    && mkdir -p "/home/${USERNAME}/.cache/sccache" \
        "/home/${USERNAME}/.local/share/mise" /workspace/target \
    && chown -R "${USERNAME}:${USERNAME}" "/home/${USERNAME}" /workspace \
    && echo 'eval "$(mise activate bash)"' >> "/home/${USERNAME}/.bashrc"

ENV CARGO_TERM_COLOR=never

USER ${USERNAME}
WORKDIR /workspace
